{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kighlander1975/deployment-engine/main/schemas/deployment.packaging-policy.schema.json",
  "title": "SHK-MOMM Deployment Packaging Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyId",
    "projectId",
    "artifactType",
    "vendorStrategy",
    "includedPaths",
    "excludedPaths",
    "executionPlanFingerprint",
    "createdAt"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "policyId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "artifactType": { "type": "string", "const": "deployment-archive" },
    "vendorStrategy": {
      "type": "string",
      "enum": [
        "exclude-install-on-target-from-lockfiles",
        "include-runtime-vendor",
        "runtime-preinstalled"
      ]
    },
    "includedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "excludedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "executionPlanFingerprint": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
